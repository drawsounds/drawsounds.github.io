{
  "name": "draw-sounds",
  "private": true,
  "version": "0.31.0",
  "homepage": "https://drawsounds.github.io",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run audio:check && npm run build",
    "audio:check": "node scripts/audit-soundfonts.mjs",
    "audio:inventory": "node scripts/audit-soundfonts.mjs --write",
    "audio:build": "node scripts/build-soundfonts.mjs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "spessasynth_lib": "^4.3.14",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jiti": "2.7.0",
    "spessasynth_core": "4.3.22",
    "typescript": "^7.0.2"
  }
}
